{
  "openapi": "3.1.0",
  "info": {
    "title": "POPIA Guard",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register",
        "description": "Creates a new account. Password is hashed with bcrypt before\nstorage; 409 if the email is already registered.",
        "operationId": "register_api_v1_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "description": "Exchanges email + password for a JWT bearer token. The token\ncarries no role/permission claims \u2014 see docs/DATABASE.md on why\nRBAC is out of scope for this project.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scans": {
      "get": {
        "tags": [
          "scans"
        ],
        "summary": "List Scans",
        "description": "Lists the authenticated user's scans, most recent first. Does not\ninclude findings or score \u2014 use GET /scans/{id} for the full result.",
        "operationId": "list_scans_api_v1_scans_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ScanJobRead"
                  },
                  "type": "array",
                  "title": "Response List Scans Api V1 Scans Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "scans"
        ],
        "summary": "Create Scan",
        "description": "Uploads a .zip archive, scans it synchronously, and returns the\nfindings, risk score, and compliance percentage. Also triggers a\nbest-effort report upload to S3 (see docs/AWS_INTEGRATION.md) \u2014 a\nstorage failure doesn't fail this request.",
        "operationId": "create_scan_api_v1_scans_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_scan_api_v1_scans_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResultRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
    "/api/v1/scans/{scan_id}": {
      "get": {
        "tags": [
          "scans"
        ],
        "summary": "Get Scan",
        "description": "Returns the scan job plus its findings and a freshly-computed score.\n\nThe score isn't persisted on the ScanJob itself \u2014 it's recomputed\nfrom the persisted findings on every request. Cheap at this data\nsize, and keeps scoring logic in exactly one place rather than\nduplicating it in the frontend. (A persisted, versioned Report\nrow does exist separately \u2014 see GET /scans/{id}/report \u2014 but it\nstores the score as of when the report was generated, not a live\nrecomputation.)",
        "operationId": "get_scan_api_v1_scans__scan_id__get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "scan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scan Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResultRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scans/{scan_id}/findings": {
      "get": {
        "tags": [
          "scans"
        ],
        "summary": "Get Scan Findings",
        "description": "Returns just the findings for a scan, without the job metadata or\nscore \u2014 a lighter-weight alternative to GET /scans/{id} for callers\nthat only need the findings list.",
        "operationId": "get_scan_findings_api_v1_scans__scan_id__findings_get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "scan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scan Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FindingRead"
                  },
                  "title": "Response Get Scan Findings Api V1 Scans  Scan Id  Findings Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scans/{scan_id}/report": {
      "get": {
        "tags": [
          "scans"
        ],
        "summary": "Get Scan Report",
        "description": "Returns a fresh presigned URL for downloading the report.\n\n404 covers two distinct cases the caller can't tell apart from the\nresponse alone: the scan doesn't exist/isn't yours, or the report\nwas never stored (e.g. S3 was unreachable when the scan completed \u2014\nsee scan_service._try_store_report). Both mean \"nothing to download\nright now,\" which is the only thing this endpoint promises.",
        "operationId": "get_scan_report_api_v1_scans__scan_id__report_get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "scan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scan Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportUrlRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Check",
        "description": "Liveness check used by Docker Compose and, later, CI.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Check Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
